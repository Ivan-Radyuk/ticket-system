# =========================================================================
# .gitignore для Maven-проекта ticket-system (ЛР №4)
#
# Зачем нужен .gitignore:
#   В Git попадает ТОЛЬКО исходный код проекта:
#       pom.xml, Jenkinsfile, src/, .gitignore
#   Результаты сборки (target/) в Git НЕ хранятся — их заново создаёт Maven.
#
#   Проверка:  git status  → не должно быть ни одного файла из target/
# =========================================================================

# --- Результаты сборки Maven (главное из задания) ---
target/

# --- Служебные файлы IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
nbproject/private/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Логи и временные файлы ---
*.log
*.tmp
*.bak
